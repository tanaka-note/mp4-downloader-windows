<Window x:Class="Mp4Downloader.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MP4 Downloader">
 <Grid x:Name="Root" Padding="24" RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel Spacing="12">
   <TextBlock Text="MP4 Downloader" FontSize="26" FontWeight="SemiBold" />
   <TextBlock Text="動画URL" />
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="UrlBox" PlaceholderText="https://example.com/video" AutomationProperties.Name="動画URL" />
    <Button x:Name="PasteButton" Grid.Column="1" Content="貼り付け" Click="Paste_Click" />
   </Grid>
   <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBox x:Name="DestinationBox" Header="保存先" IsReadOnly="True" />
    <Button x:Name="FolderButton" Grid.Column="1" Content="変更" VerticalAlignment="Bottom" Click="Folder_Click" />
   </Grid>
   <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="DownloadButton" Content="ダウンロード" Click="Download_Click" Style="{StaticResource AccentButtonStyle}" />
    <Button x:Name="CancelButton" Content="中止" Click="Cancel_Click" IsEnabled="False" />
    <Button x:Name="OpenButton" Content="保存場所を開く" Click="Open_Click" IsEnabled="False" />
   </StackPanel>
   <TextBlock x:Name="Status" Text="URLを貼り付けてダウンロードしてください。" TextWrapping="Wrap" />
   <ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Value="0" />
  </StackPanel>
  <Pivot Grid.Row="1">
   <PivotItem Header="履歴"><ScrollViewer><StackPanel x:Name="HistoryPanel" Spacing="8" /></ScrollViewer></PivotItem>
   <PivotItem Header="設定"><StackPanel Spacing="12">
    <Button x:Name="ClearHistoryButton" Content="履歴を削除" Click="ClearHistory_Click" />
    <Button x:Name="ClearTempButton" Content="残った一時ファイルを削除" Click="ClearTemp_Click" />
    <Button x:Name="ClearBrowserButton" Content="WebView2データを削除" Click="ClearBrowser_Click" />
    <HyperlinkButton Content="WebView2 Runtime導入案内（Microsoft公式）" NavigateUri="https://developer.microsoft.com/microsoft-edge/webview2/" />
    <TextBlock Text="非DRMのVODのみ対応。アプリ独自のクラウド送信・テレメトリは行いません。Windows側の保護機能などはOS設定に従って通信する場合があります。" TextWrapping="Wrap" />
   </StackPanel></PivotItem>
  </Pivot>
 </Grid>
</Window>
